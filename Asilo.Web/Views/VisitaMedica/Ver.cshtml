@model Asilo.Web.Models.VisitaMedica

@{
    ViewData["Title"] = "Visita médica";

    var esAdministrador =
        User.IsInRole("Administrador");

    var esEspecialista =
        User.IsInRole("Médico especialista");

    var esEspecialistaResponsable =
        esEspecialista &&
        User.Identity?.Name == Model.Medico;

    var puedeContinuarAtencion =
        esAdministrador ||
        esEspecialistaResponsable;
}

<div class="container mt-4 mb-5">

    <!-- ENCABEZADO -->

    <div class="d-flex justify-content-between
        align-items-start mb-4">

        <div>
            <h2 class="mb-1">
                Visita médica
            </h2>

            <p class="text-muted mb-0">
                Detalle de la atención realizada al paciente.
            </p>
        </div>

        <a asp-controller="Solicitudes"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Volver a solicitudes
        </a>

    </div>


    <!-- RESUMEN -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3 mb-md-0">

                    <small class="text-muted d-block">
                        Paciente
                    </small>

                    <strong>
                        @Model.Paciente?.NombreCompleto
                    </strong>

                </div>


                <div class="col-md-4 mb-3 mb-md-0">

                    <small class="text-muted d-block">
                        Fecha de visita
                    </small>

                    <strong>
                        @Model.FechaVisita.ToString(
                            "dd/MM/yyyy HH:mm")
                    </strong>

                </div>


                <div class="col-md-4">

                    <small class="text-muted d-block">
                        Médico especialista
                    </small>

                    <strong>
                        @Model.Medico
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- INFORMACIÓN CLÍNICA -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h5 class="mb-4">
                Información clínica
            </h5>


            <div class="mb-4">

                <small class="text-muted d-block mb-1">
                    Diagnóstico
                </small>

                <div class="border rounded p-3 bg-light">
                    @Model.Diagnostico
                </div>

            </div>


            <div>

                <small class="text-muted d-block mb-1">
                    Observaciones
                </small>

                <div class="border rounded p-3">
                    @Model.Observaciones
                </div>

            </div>

        </div>

    </div>


    <!-- ACCIONES DE LA VISITA -->

    <div class="card shadow-sm border-0 mb-4">

               
    <div class="card-body">

        <h4 class="mb-1">
            Acciones de la visita
        </h4>

        <p class="text-muted">
            Consulte la información clínica registrada durante esta visita.
        </p>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="FichaMedica"
               asp-action="Ver"
               asp-route-pacienteId="@Model.PacienteId"
               asp-route-visitaId="@Model.Id"
               class="btn btn-outline-primary">
                Ver ficha médica
            </a>

            <a asp-controller="HistorialMedico"
               asp-action="Index"
               asp-route-pacienteId="@Model.PacienteId"
               asp-route-visitaId="@Model.Id"
               class="btn btn-outline-primary">
                Ver historial médico
            </a>

            @if (User.IsInRole("Enfermero"))
            {
                <a asp-controller="MedicamentosAplicados"
                   asp-action="Aplicar"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Registrar medicamento aplicado
                </a>
            }

        </div>

  

                <!-- SOLO ESPECIALISTA RESPONSABLE -->
                @if (puedeContinuarAtencion)
                {
                    @if (Model.ExamenesLaboratorio != null &&
     Model.ExamenesLaboratorio.Any())
                    {
                        <a asp-controller="Laboratorio"
                           asp-action="Index"
                           asp-route-visitaId="@Model.Id"
                           class="btn btn-outline-primary">
                            Ver exámenes
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Laboratorio"
                           asp-action="Crear"
                           asp-route-visitaId="@Model.Id"
                           class="btn btn-primary">
                            Solicitar examen
                        </a>
                    }


                    @if (Model.Receta != null)
                    {
                        <a asp-controller="Recetas"
                           asp-action="Detalle"
                           asp-route-id="@Model.Receta.Id"
                           class="btn btn-outline-success">
                            Ver receta
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Recetas"
                           asp-action="Crear"
                           asp-route-visitaId="@Model.Id"
                           class="btn btn-success">
                            Crear receta
                        </a>
                    }
                }

            </div>

        </div>

    </div>


    <!-- COSTO SOLO INFORMATIVO -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h5 class="mb-1">
                Información de costo
            </h5>

            <p class="text-muted">
                Este costo será incorporado posteriormente
                al módulo administrativo de cobros.
            </p>

            <small class="text-muted d-block">
                Costo de consulta
            </small>

            <strong class="fs-5">
                Q @Model.CostoConsulta.ToString("0.00")
            </strong>

        </div>

    </div>


    <!-- NAVEGACIÓN -->

    <div class="d-flex justify-content-end">

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary">

            Volver al menú principal

        </a>

    </div>

</div>