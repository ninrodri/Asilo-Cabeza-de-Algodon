@model Asilo.Web.Models.ExamenLaboratorio

@{
    ViewData["Title"] = "Registrar resultado de laboratorio";
}

<div class="container mt-4 mb-5">

    <h2 class="mb-3">
        Registrar resultado de laboratorio
    </h2>

    <div class="alert alert-info">
        <strong>Paciente:</strong>
        @Model.Paciente?.NombreCompleto
        <br />

        <strong>Examen:</strong>
        @Model.NombreExamen
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
    {
        <div class="alert alert-light border">
            <strong>Indicaciones del médico:</strong>
            <br />
            @Model.Observaciones
        </div>
    }

    <form asp-action="Resultado"
          method="post">

        <input type="hidden"
               asp-for="Id" />

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="Resultado"
                   class="form-label">
                Resultado
            </label>

            <textarea asp-for="Resultado"
                      class="form-control"
                      rows="5">
            </textarea>

            <span asp-validation-for="Resultado"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Costo"
                   class="form-label">
                Costo del examen
            </label>

            <input asp-for="Costo"
                   type="number"
                   min="0"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Costo"
                  class="text-danger">
            </span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Guardar resultado
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>