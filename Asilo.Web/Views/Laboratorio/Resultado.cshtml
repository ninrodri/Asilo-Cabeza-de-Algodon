@model Asilo.Web.Models.ExamenLaboratorio

@{
    ViewData["Title"] = "Registrar resultado";
}

<div class="container mt-4">

    <h2>Registrar resultado de laboratorio</h2>

    <div class="alert alert-info">
        <strong>Paciente:</strong>
        @Model.Paciente?.NombreCompleto
        <br />

        <strong>Examen:</strong>
        @Model.NombreExamen
    </div>

    <form asp-action="Resultado" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Resultado"
                   class="form-label">
            </label>

            <textarea asp-for="Resultado"
                      class="form-control"
                      rows="5"></textarea>

            <span asp-validation-for="Resultado"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Observaciones"
                   class="form-label">
            </label>

            <textarea asp-for="Observaciones"
                      class="form-control"
                      rows="3"></textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Guardar resultado
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>