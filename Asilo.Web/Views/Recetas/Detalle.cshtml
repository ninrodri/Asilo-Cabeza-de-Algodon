@model Asilo.Web.Models.Receta

@{
    ViewData["Title"] = "Detalle de receta";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Receta médica</h2>

            <p class="text-muted">
                Detalle de medicamentos e indicaciones.
            </p>
        </div>

        <a asp-controller="Solicitudes"
           asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Aviso"] != null)
    {
        <div class="alert alert-info">
            @TempData["Aviso"]
        </div>
    }

    @if (TempData["Advertencia"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Advertencia"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <p>
                <strong>Paciente:</strong>
                @Model.Paciente?.NombreCompleto
            </p>

            <p>
                <strong>Médico:</strong>
                @Model.Medico
            </p>

            <p>
                <strong>Fecha:</strong>
                @Model.FechaReceta.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Estado:</strong>
                @Model.Estado
            </p>


        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-3">

        @if (Model.Estado == "Pendiente")
        {
            <a asp-action="AgregarMedicamento"
               asp-route-recetaId="@Model.Id"
               class="btn btn-primary">
                Agregar medicamento
            </a>

            <form asp-action="Finalizar"
                  method="post"
                  class="d-inline">

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-success">
                    Emitir receta
                </button>

            </form>
        }

    </div>
    
    </div>

    @if (!Model.Detalles.Any())
    {
        <div class="alert alert-info">
            Esta receta todavía no tiene medicamentos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead>
                    <tr>
                        <th>Medicamento</th>
                        <th>Dosis</th>
                        <th>Frecuencia</th>
                        <th>Duración</th>
                        <th>Indicaciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var detalle in Model.Detalles)
                    {
                        <tr>
                            <td>@detalle.Medicamento</td>
                            <td>@detalle.Dosis</td>
                            <td>@detalle.Frecuencia</td>
                            <td>@detalle.Duracion</td>
                            <td>@detalle.Indicaciones</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>