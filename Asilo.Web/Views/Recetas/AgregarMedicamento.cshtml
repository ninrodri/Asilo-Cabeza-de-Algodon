@model Asilo.Web.Models.DetalleReceta

@{
    ViewData["Title"] = "Agregar medicamento";

    var receta =
        ViewBag.Receta as Asilo.Web.Models.Receta;
}

<div class="container mt-4 mb-5">

    <!-- ENCABEZADO -->

    <div class="mb-4">
        <h2 class="mb-1">
            Agregar medicamento
        </h2>

        <p class="text-muted mb-0">
            Registre la dosis, frecuencia, duración y presentación
            indicada para el paciente.
        </p>
    </div>


    <!-- DATOS DE LA RECETA -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">
                    <small class="text-muted d-block">
                        Paciente
                    </small>

                    <strong>
                        @receta?.Paciente?.NombreCompleto
                    </strong>
                </div>

                <div class="col-md-6">
                    <small class="text-muted d-block">
                        Médico especialista
                    </small>

                    <strong>
                        @receta?.Medico
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <!-- FORMULARIO -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="AgregarMedicamento"
                  method="post">

                <input type="hidden"
                       asp-for="RecetaId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- MEDICAMENTO -->

                <div class="mb-4">

                    <label asp-for="Medicamento"
                           class="form-label">
                        Medicamento
                    </label>

                    <input asp-for="Medicamento"
                           class="form-control"
                           placeholder="Ej. Acetaminofén 500 mg" />

                    <span asp-validation-for="Medicamento"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Incluya la concentración cuando corresponda.
                    </small>

                </div>


                <!-- FORMA FARMACÉUTICA -->

                <div class="mb-4">

                    <label asp-for="FormaFarmaceutica"
                           class="form-label">
                        Forma farmacéutica
                    </label>

                    <select asp-for="FormaFarmaceutica"
                            id="FormaFarmaceutica"
                            class="form-select">

                        <option value="">
                            Seleccione...
                        </option>

                        <option value="Tableta">
                            Tableta
                        </option>

                        <option value="Cápsula">
                            Cápsula
                        </option>

                        <option value="Jarabe">
                            Jarabe
                        </option>

                        <option value="Solución bebible">
                            Solución bebible
                        </option>

                        <option value="Ampolla">
                            Ampolla
                        </option>

                        <option value="Inyección">
                            Inyección
                        </option>

                        <option value="Gotas">
                            Gotas
                        </option>

                        <option value="Crema">
                            Crema
                        </option>

                        <option value="Otro">
                            Otro
                        </option>

                    </select>

                    <span asp-validation-for="FormaFarmaceutica"
                          class="text-danger">
                    </span>

                </div>


                <!-- DOSIS -->

                <h5 class="mt-4 mb-3">
                    Dosificación
                </h5>

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label asp-for="DosisPorToma"
                               class="form-label">
                            Cantidad por toma
                        </label>

                        <input asp-for="DosisPorToma"
                               id="DosisPorToma"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               placeholder="Ej. 1" />

                        <span asp-validation-for="DosisPorToma"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label asp-for="UnidadDosis"
                               class="form-label">
                            Unidad de la dosis
                        </label>

                        <select asp-for="UnidadDosis"
                                id="UnidadDosis"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                            <option value="tableta">
                                Tableta
                            </option>

                            <option value="cápsula">
                                Cápsula
                            </option>

                            <option value="ml">
                                ml
                            </option>

                            <option value="ampolla">
                                Ampolla
                            </option>

                            <option value="inyección">
                                Inyección
                            </option>

                            <option value="gota">
                                Gota
                            </option>

                            <option value="aplicación">
                                Aplicación
                            </option>

                        </select>

                        <span asp-validation-for="UnidadDosis"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label asp-for="TomasPorDia"
                               class="form-label">
                            Tomas o aplicaciones por día
                        </label>

                        <input asp-for="TomasPorDia"
                               id="TomasPorDia"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Ej. 3" />

                        <span asp-validation-for="TomasPorDia"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="row">

                    <div class="col-md-4 mb-4">

                        <label asp-for="DuracionDias"
                               class="form-label">
                            Duración en días
                        </label>

                        <input asp-for="DuracionDias"
                               id="DuracionDias"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="Ej. 7" />

                        <span asp-validation-for="DuracionDias"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- PRESENTACIÓN -->

                <h5 class="mt-2 mb-3">
                    Presentación del medicamento
                </h5>

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label asp-for="Presentacion"
                               class="form-label">
                            Presentación
                        </label>

                        <select asp-for="Presentacion"
                                id="Presentacion"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                            <option value="Unidad">
                                Unidad
                            </option>

                            <option value="Blíster">
                                Blíster
                            </option>

                            <option value="Caja">
                                Caja
                            </option>

                            <option value="Frasco">
                                Frasco
                            </option>

                            <option value="Ampolla">
                                Ampolla
                            </option>

                            <option value="Vial">
                                Vial
                            </option>

                            <option value="Tubo">
                                Tubo
                            </option>

                        </select>

                        <span asp-validation-for="Presentacion"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label asp-for="ContenidoPresentacion"
                               class="form-label">
                            Contenido por presentación
                        </label>

                        <input asp-for="ContenidoPresentacion"
                               id="ContenidoPresentacion"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               placeholder="Ej. 120" />

                        <span asp-validation-for="ContenidoPresentacion"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-4 mb-3">

                        <label asp-for="UnidadPresentacion"
                               class="form-label">
                            Unidad del contenido
                        </label>

                        <select asp-for="UnidadPresentacion"
                                id="UnidadPresentacion"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                            <option value="tabletas">
                                Tabletas
                            </option>

                            <option value="cápsulas">
                                Cápsulas
                            </option>

                            <option value="ml">
                                ml
                            </option>

                            <option value="ampollas">
                                Ampollas
                            </option>

                            <option value="inyecciones">
                                Inyecciones
                            </option>

                            <option value="gotas">
                                Gotas
                            </option>

                            <option value="aplicaciones">
                                Aplicaciones
                            </option>

                        </select>

                        <span asp-validation-for="UnidadPresentacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- CÁLCULO PRELIMINAR -->

                <div class="alert alert-info mt-3"
                     id="CalculoMedicamento"
                     style="display:none;">

                    <strong>
                        Cálculo estimado:
                    </strong>

                    <div class="mt-2">
                        Cantidad total necesaria:
                        <span id="CantidadTotal">
                            0
                        </span>
                    </div>

                    <div>
                        Presentaciones sugeridas para entregar:
                        <strong id="CantidadSugerida">
                            0
                        </strong>
                    </div>

                    <small class="text-muted d-block mt-2">
                        Este cálculo es una ayuda para Farmacia.
                        La dosis médica no es modificada por el sistema.
                    </small>

                </div>


                <!-- INDICACIONES -->

                <div class="mb-4 mt-4">

                    <label asp-for="Indicaciones"
                           class="form-label">
                        Indicaciones de administración
                    </label>

                    <textarea asp-for="Indicaciones"
                              class="form-control"
                              rows="3"
                              placeholder="Ej. Administrar después de los alimentos"></textarea>

                    <span asp-validation-for="Indicaciones"
                          class="text-danger">
                    </span>

                </div>


                <!-- BOTONES -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar medicamento
                    </button>

                    @if (receta != null)
                    {
                        <a asp-controller="VisitaMedica"
                           asp-action="Ver"
                           asp-route-id="@receta.VisitaMedicaId"
                           class="btn btn-secondary">
                            Cancelar
                        </a>
                    }

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <script>
        function calcularCantidad() {

            const dosis =
                parseFloat(
                    document.getElementById("DosisPorToma").value
                ) || 0;

            const tomas =
                parseInt(
                    document.getElementById("TomasPorDia").value
                ) || 0;

            const dias =
                parseInt(
                    document.getElementById("DuracionDias").value
                ) || 0;

            const contenido =
                parseFloat(
                    document.getElementById("ContenidoPresentacion").value
                ) || 0;

            const unidadDosis =
                document.getElementById("UnidadDosis").value;

            const presentacion =
                document.getElementById("Presentacion").value;

            const cantidadTotal =
                dosis * tomas * dias;

            let cantidadSugerida = 0;

            if (contenido > 0) {
                cantidadSugerida =
                    Math.ceil(
                        cantidadTotal / contenido
                    );
            }

            if (cantidadTotal > 0 &&
                contenido > 0) {

                document.getElementById(
                    "CalculoMedicamento"
                ).style.display = "block";

                document.getElementById(
                    "CantidadTotal"
                ).innerText =
                    cantidadTotal.toFixed(2) +
                    " " +
                    unidadDosis;

                document.getElementById(
                    "CantidadSugerida"
                ).innerText =
                    cantidadSugerida +
                    " " +
                    presentacion +
                    (cantidadSugerida != 1 ? "s" : "");
            }
            else {

                document.getElementById(
                    "CalculoMedicamento"
                ).style.display = "none";
            }
        }


        document.getElementById("DosisPorToma")
            .addEventListener(
                "input",
                calcularCantidad
            );

        document.getElementById("TomasPorDia")
            .addEventListener(
                "input",
                calcularCantidad
            );

        document.getElementById("DuracionDias")
            .addEventListener(
                "input",
                calcularCantidad
            );

        document.getElementById("ContenidoPresentacion")
            .addEventListener(
                "input",
                calcularCantidad
            );

        document.getElementById("UnidadDosis")
            .addEventListener(
                "change",
                calcularCantidad
            );

        document.getElementById("Presentacion")
            .addEventListener(
                "change",
                calcularCantidad
            );


        calcularCantidad();
    </script>
}