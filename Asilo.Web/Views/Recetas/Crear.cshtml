@model Asilo.Web.Models.Receta

@{
    ViewData["Title"] = "Crear receta";
}

<div class="container mt-4">

    <h2>Crear receta médica</h2>

    <div class="alert alert-info">
        <strong>Paciente:</strong>
        @Model.Paciente?.NombreCompleto
        <br />

        <strong>Médico:</strong>
        @Model.Medico
    </div>

    <p class="text-muted">
        Cree la receta para comenzar a agregar los medicamentos indicados.
    </p>

    <form asp-action="Crear" method="post">

        <input type="hidden"
               asp-for="PacienteId" />

        <input type="hidden"
               asp-for="VisitaMedicaId" />

        <input type="hidden"
               asp-for="Medico" />

        <button type="submit"
                class="btn btn-primary">
            Crear receta
        </button>

        <a asp-controller="VisitaMedica"
           asp-action="Ver"
           asp-route-id="@Model.VisitaMedicaId"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>