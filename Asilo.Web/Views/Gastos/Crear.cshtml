@model Asilo.Web.Models.Gasto

@{
    ViewData["Title"] = "Nuevo gasto";
}

<div class="container mt-4">

    <h2>Nuevo gasto</h2>

    <p class="text-muted">
        Registre un egreso realizado por el asilo.
    </p>

    <form asp-action="Crear" method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label asp-for="Categoria"
                   class="form-label">
            </label>

            <select asp-for="Categoria"
                    class="form-select">

                <option value="">
                    Seleccione una categoría
                </option>

                <option value="Luz">Luz</option>
                <option value="Agua">Agua</option>
                <option value="Alimentación">Alimentación</option>
                <option value="Medicamentos">Medicamentos</option>
                <option value="Mantenimiento">Mantenimiento</option>
                <option value="Otros">Otros</option>

            </select>

            <span asp-validation-for="Categoria"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Descripcion"
                   class="form-label">
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="3">
            </textarea>

            <span asp-validation-for="Descripcion"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Proveedor"
                   class="form-label">
            </label>

            <input asp-for="Proveedor"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label asp-for="Referencia"
                   class="form-label">
            </label>

            <input asp-for="Referencia"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label asp-for="Monto"
                   class="form-label">
            </label>

            <input asp-for="Monto"
                   type="number"
                   min="0.01"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Monto"
                  class="text-danger">
            </span>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Registrar gasto
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>