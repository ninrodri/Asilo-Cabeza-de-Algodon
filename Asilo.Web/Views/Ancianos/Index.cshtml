@model IEnumerable<Asilo.Web.Models.Anciano>

@{
    ViewData["Title"] = "Internos registrados";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Internos registrados</h1>
            <p class="text-muted">
                Consulta de residentes registrados en el asilo.
            </p>
        </div>

        <a asp-action="Registrar"
           class="btn btn-primary">
            Registrar nuevo interno
        </a>
    </div>

    <form asp-action="Index" method="get" class="mb-3">

        <div class="input-group">

            <input type="text"
                   name="buscar"
                   value="@ViewBag.Buscar"
                   class="form-control"
                   placeholder="Buscar paciente por nombre..." />

            <button type="submit"
                    class="btn btn-primary">
                Buscar
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Limpiar
            </a>

        </div>

    </form>

    <div class="card">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Fecha de nacimiento</th>
                            <th>Sexo</th>
                            <th>Fecha de ingreso</th>
                            <th>Familiar responsable</th>
                            <th>Teléfono</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>

                    <tbody>
                        @foreach (var paciente in Model)
                        {
                            <tr>
                                <td>@paciente.Id</td>
                                <td>@paciente.NombreCompleto</td>
                                <td>@paciente.FechaNacimiento?.ToString("dd/MM/yyyy")</td>
                                <td>@paciente.Sexo</td>
                                <td>@paciente.FechaIngreso?.ToString("dd/MM/yyyy")</td>
                                <td>@paciente.FamiliarResponsable</td>
                                <td>@paciente.TelefonoFamiliar</td>

                                <td>
                                    <a asp-action="Editar"
                                       asp-route-id="@paciente.Id"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Eliminar"
                                       asp-route-id="@paciente.Id"
                                       class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>

                                    <a asp-controller="FichaMedica"
                                       asp-action="Ver"
                                       asp-route-pacienteId="@paciente.Id"
                                       class="btn btn-info btn-sm">
                                        Ficha médica
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
