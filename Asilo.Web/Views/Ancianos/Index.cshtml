@model IEnumerable<Asilo.Web.Models.Anciano>

@{
    ViewData["Title"] = "Internos registrados";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Internos registrados</h2>
            <p class="text-muted mb-0">
                Consulta y gestión de los pacientes registrados en el asilo.
            </p>
        </div>

        <a asp-action="Registrar"
           class="btn btn-primary">
            Registrar nuevo interno
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="mb-4">

                <div class="input-group">

                    <input type="text"
                           name="buscar"
                           value="@ViewBag.Buscar"
                           class="form-control"
                           placeholder="Buscar paciente por nombre..." />

                    <button type="submit"
                            class="btn btn-primary">
                        Buscar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>

                </div>

            </form>

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    No se encontraron pacientes registrados.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Paciente</th>
                                <th>Fecha de nacimiento</th>
                                <th>Sexo</th>
                                <th>Familiar responsable</th>
                                <th>Fecha de ingreso</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var paciente in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="d-flex align-items-center">

                                            <div class="me-3">

                                                <div class="rounded-circle bg-light border
                                                    d-flex align-items-center justify-content-center"
                                                     style="width: 42px; height: 42px;">

                                                    <span class="fw-bold text-primary">
                                                        @(string.IsNullOrWhiteSpace(paciente.NombreCompleto)
                                                            ? "?"
                                                            : paciente.NombreCompleto.Substring(0, 1).ToUpper())
                                                    </span>

                                                </div>

                                            </div>

                                            <div>

                                                <a asp-action="Detalle"
                                                   asp-route-id="@paciente.Id"
                                                   class="fw-semibold text-decoration-none">

                                                    @paciente.NombreCompleto

                                                </a>

                                                <div class="text-muted small">
                                                    ID: @paciente.Id
                                                </div>

                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @paciente.FechaNacimiento?.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @paciente.Sexo
                                    </td>

                                    <td>
                                        @paciente.FamiliarResponsable
                                    </td>

                                    <td>
                                        @paciente.FechaIngreso?.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>