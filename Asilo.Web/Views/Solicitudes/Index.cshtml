@model IEnumerable<Asilo.Web.Models.SolicitudMedica>

@{
    ViewData["Title"] = "Solicitudes médicas";
}

<div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4"> 
    <div> 
        <h2>Solicitudes médicas</h2> 
        <p class="text-muted"> 
            Consulta y seguimiento de referencias médicas. 
        </p> 
    </div> 

    <a asp-action="Crear" 
       class="btn btn-primary"> 
        Nueva solicitud 
    </a> 
</div> 

        @if (TempData["Exito"] != null)
          {
         <div class="alert alert-success">
        @TempData["Exito"]
        </div>
        }

        @if (TempData["Advertencia"] != null)
        {
          <div class="alert alert-warning">
        @TempData["Advertencia"]
         </div>
            }

        @if (!Model.Any()) 
        { 
         <div class="alert alert-info"> 
            No hay solicitudes médicas registradas. 
            </div> 
            }

         else
        {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Paciente</th>
                        <th>Médico</th>
                        <th>Especialidad</th>
                        <th>Motivo</th>
                        <th>Estado / Acciones</th>
                    </tr>
                </thead>

                <tbody>
    @foreach (var solicitud in Model)
    {
        <tr>
            <td>
                @solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
            </td>

            <td>
                @solicitud.Paciente?.NombreCompleto
            </td>

            <td>
                @solicitud.MedicoReferido
            </td>

            <td>
                @solicitud.Especialidad
            </td>

            <td>
                @solicitud.Motivo
            </td>

            <td>
                <form asp-action="CambiarEstado"
                      method="post"
                      class="d-flex gap-2">

                    <input type="hidden"
                           name="id"
                           value="@solicitud.Id" />

                    <select name="estado"
                            class="form-select form-select-sm">

                        @foreach (var estado in new[]
                        {
                            "Pendiente",
                            "Asignada",
                            "Atendida",
                            "Finalizada"
                        })
                        {
                            if (solicitud.Estado == estado)
                            {
                                <option value="@estado" selected>
                                    @estado
                                </option>
                            }
                            else
                            {
                                <option value="@estado">
                                    @estado
                                </option>
                            }
                        }

                    </select>

                    <button type="submit"
                            class="btn btn-success btn-sm">
                        Guardar
                    </button>

                </form>
            </td>
        </tr>
    }
</tbody>

            </table>

        </div>
    }

</div>
