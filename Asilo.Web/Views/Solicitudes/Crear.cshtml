@model Asilo.Web.Models.SolicitudMedica

@{
    ViewData["Title"] = "Nueva Solicitud Médica";
}

<div class="container mt-4">

    <h1>Nueva Solicitud Médica</h1>

    <p class="text-muted">
    Revise la información de la referencia médica.
    La Fundación asignará posteriormente al especialista,
    al enfermero acompañante y el horario de atención.
</p>

    <form asp-action="Crear" method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="PacienteId"
                   class="form-label">
            </label>

            <select asp-for="PacienteId"
                    class="form-select">

                <option value="">
                    Seleccione un paciente
                </option>

                @foreach (var paciente in ViewBag.Pacientes)
                {
                    <option value="@paciente.Id">
                        @paciente.NombreCompleto
                    </option>
                }

            </select>

            <span asp-validation-for="PacienteId"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
    <label asp-for="Especialidad"
           class="form-label">
        Especialidad requerida
    </label>

    <input asp-for="Especialidad"
           class="form-control"
           readonly />

    <span asp-validation-for="Especialidad"
          class="text-danger">
    </span>
</div>

        <div class="mb-3">
            <label asp-for="Motivo"
                   class="form-label">
            </label>

            <textarea asp-for="Motivo"
                      class="form-control"
                      rows="4"
                      placeholder="Describa por qué el paciente requiere evaluación especializada.">
            </textarea>

            <span asp-validation-for="Motivo"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Observaciones"
                   class="form-label">
            </label>

            <textarea asp-for="Observaciones"
                      class="form-control"
                      rows="3"
                      placeholder="Observaciones de la evaluación realizada por el médico general.">
            </textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Enviar solicitud a Fundación
        </button>

       <a asp-controller="Dashboard"
        asp-action="Index"
        class="btn btn-secondary">
        Cancelar
        </a>

    </form>

</div>