@model Asilo.Web.Models.SolicitudMedica

@{
    ViewData["Title"] = "Nueva Solicitud Médica";
}

<div class="container mt-4">

    <h1>Nueva Solicitud Médica</h1>

    <p class="text-muted">
        Seleccione al paciente e ingrese los datos de la referencia médica.
        El familiar y su correo se obtendrán automáticamente del sistema.
    </p>

    <form asp-action="Crear" method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="PacienteId"
                   class="form-label">
            </label>

            <select asp-for="PacienteId"
                    class="form-select">

                <option value="">
                    Seleccione un paciente
                </option>

                @foreach (var paciente in ViewBag.Pacientes)
                {
                    <option value="@paciente.Id">
                        @paciente.NombreCompleto
                    </option>
                }

            </select>

            <span asp-validation-for="PacienteId"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="MedicoReferido"
                   class="form-label">
            </label>

            <select asp-for="MedicoReferido"
                    id="MedicoReferido"
                    class="form-select">

                <option value="">
                    Seleccione un médico
                </option>

                @foreach (var medico in ViewBag.Medicos)
                {
                    <option value="@medico.NombreUsuario"
                            data-especialidad="@medico.Especialidad">
                        @medico.NombreUsuario - @medico.Rol?.Nombre
                    </option>
                }

            </select>

            <span asp-validation-for="MedicoReferido"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Especialidad"
                   class="form-label">
            </label>

            <input asp-for="Especialidad"
                   id="Especialidad"
                   class="form-control"
                   readonly />

            <span asp-validation-for="Especialidad"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Motivo"
                   class="form-label">
            </label>

            <textarea asp-for="Motivo"
                      class="form-control"
                      rows="4">
            </textarea>

            <span asp-validation-for="Motivo"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Observaciones"
                   class="form-label">
            </label>

            <textarea asp-for="Observaciones"
                      class="form-control"
                      rows="3">
            </textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Crear solicitud
        </button>

        <a asp-controller="Ancianos"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>

@section Scripts {
    <script>
        document.getElementById("MedicoReferido")
            .addEventListener("change", function () {

                const opcionSeleccionada =
                    this.options[this.selectedIndex];

                const especialidad =
                    opcionSeleccionada.getAttribute("data-especialidad");

                document.getElementById("Especialidad").value =
                    especialidad || "";
            });
    </script>
}