@model Asilo.Web.Models.Receta

@{
    ViewData["Title"] = "Detalle de receta";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Detalle de receta</h2>
            <p class="text-muted">
                Medicamentos prescritos al paciente.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <p>
                <strong>Paciente:</strong>
                @Model.Paciente?.NombreCompleto
            </p>

            <p>
                <strong>Médico:</strong>
                @Model.Medico
            </p>

            <p>
                <strong>Fecha:</strong>
                @Model.FechaReceta.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Estado:</strong>
                @Model.Estado
            </p>

            <p>
                <strong>Indicaciones generales:</strong>
                @Model.IndicacionesGenerales
            </p>

        </div>
    </div>

    <h4 class="mb-3">Medicamentos</h4>

    @if (!Model.Detalles.Any())
    {
        <div class="alert alert-info">
            La receta no tiene medicamentos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead>
                    <tr>
                        <th>Medicamento</th>
                        <th>Dosis</th>
                        <th>Frecuencia</th>
                        <th>Duración</th>
                        <th>Indicaciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var detalle in Model.Detalles)
                    {
                        <tr>
                            <td>@detalle.Medicamento</td>
                            <td>@detalle.Dosis</td>
                            <td>@detalle.Frecuencia</td>
                            <td>@detalle.Duracion</td>
                            <td>@detalle.Indicaciones</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>