@model Asilo.Web.Models.Receta

@{
    ViewData["Title"] = "Detalle de receta";

    var totalReceta = Model.Detalles.Sum(d => d.Subtotal);
    var entregada = Model.Estado == "Entregada";
}

<div class="container mt-4 mb-5">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Detalle de receta
            </h2>

            <p class="text-muted mb-0">
                Revise la prescripción y registre los medicamentos entregados.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            Volver a farmacia
        </a>

    </div>


    <!-- MENSAJES -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Advertencia"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Advertencia"]
        </div>
    }


    <!-- DATOS GENERALES -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-3 mb-3">
                    <small class="text-muted d-block">
                        Paciente
                    </small>

                    <strong>
                        @Model.Paciente?.NombreCompleto
                    </strong>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted d-block">
                        Médico especialista
                    </small>

                    <strong>
                        @Model.Medico
                    </strong>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted d-block">
                        Fecha
                    </small>

                    <strong>
                        @Model.FechaReceta.ToString("dd/MM/yyyy HH:mm")
                    </strong>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted d-block">
                        Estado
                    </small>

                    @if (entregada)
                    {
                        <span class="badge bg-success">
                            Entregada
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            @Model.Estado
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- MEDICAMENTOS -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h4 class="mb-3">
                Medicamentos prescritos
            </h4>

            @if (!Model.Detalles.Any())
            {
                <div class="alert alert-info mb-0">
                    La receta no tiene medicamentos registrados.
                </div>
            }
            else
            {
                @foreach (var detalle in Model.Detalles)
                {
                    var cantidadMostrar =
                        detalle.Cantidad > 0
                        ? detalle.Cantidad
                        : detalle.CantidadSugerida;

                    <div class="border rounded p-3 mb-4">

                        <!-- MEDICAMENTO -->
                        <div class="d-flex justify-content-between
                                    align-items-start mb-3">

                            <div>
                                <h5 class="mb-1">
                                    @detalle.Medicamento
                                </h5>

                                <span class="badge bg-light text-dark border">
                                    @detalle.FormaFarmaceutica
                                </span>
                            </div>

                            @if (entregada)
                            {
                                <span class="badge bg-success">
                                    Entregado
                                </span>
                            }

                        </div>


                        <!-- PRESCRIPCIÓN -->
                        <div class="row mb-3">

                            <div class="col-md-3 mb-2">
                                <small class="text-muted d-block">
                                    Dosis
                                </small>

                                <strong>
                                    @detalle.Dosis
                                </strong>
                            </div>


                            <div class="col-md-3 mb-2">
                                <small class="text-muted d-block">
                                    Frecuencia
                                </small>

                                <strong>
                                    @detalle.Frecuencia
                                </strong>
                            </div>


                            <div class="col-md-3 mb-2">
                                <small class="text-muted d-block">
                                    Duración
                                </small>

                                <strong>
                                    @detalle.Duracion
                                </strong>
                            </div>


                            <div class="col-md-3 mb-2">
                                <small class="text-muted d-block">
                                    Indicaciones
                                </small>

                                <strong>
                                    @detalle.Indicaciones
                                </strong>
                            </div>

                        </div>


                        <!-- CÁLCULO AUTOMÁTICO -->
                        <div class="alert alert-info">

                            <div class="row">

                                <div class="col-md-4 mb-2">
                                    <small class="d-block">
                                        Cantidad total necesaria
                                    </small>

                                    <strong>
                                        @detalle.CantidadTotalNecesaria.ToString("0.##")
                                        @detalle.UnidadDosis
                                    </strong>
                                </div>


                                <div class="col-md-4 mb-2">
                                    <small class="d-block">
                                        Presentación
                                    </small>

                                    <strong>
                                        @detalle.Presentacion
                                        de
                                        @detalle.ContenidoPresentacion.ToString("0.##")
                                        @detalle.UnidadPresentacion
                                    </strong>
                                </div>


                                <div class="col-md-4 mb-2">
                                    <small class="d-block">
                                        Cantidad sugerida
                                    </small>

                                    <strong>
                                        @detalle.CantidadSugerida
                                        @detalle.Presentacion@(detalle.CantidadSugerida == 1 ? "" : "s")
                                    </strong>
                                </div>

                            </div>

                            <small class="text-muted">
                                La cantidad sugerida se calcula según la dosis,
                                frecuencia, duración y presentación prescritas.
                            </small>

                        </div>


                        <!-- FARMACIA -->
                        @if (!entregada)
                        {
                            <form id="formCosto-@detalle.Id"
                                  asp-action="ActualizarCosto"
                                  method="post">

                                <input type="hidden"
                                       name="detalleId"
                                       value="@detalle.Id" />

                                <div class="row align-items-end">

                                    <div class="col-md-4 mb-3">

                                        <label class="form-label">
                                            Cantidad a entregar
                                        </label>

                                        <input type="number"
                                               name="cantidad"
                                               value="@cantidadMostrar"
                                               min="1"
                                               step="1"
                                               class="form-control" />

                                        <small class="text-muted">
                                            Sugerido:
                                            @detalle.CantidadSugerida
                                        </small>

                                    </div>


                                    <div class="col-md-4 mb-3">

                                        <label class="form-label">
                                            Precio unitario
                                        </label>

                                        <div class="input-group">

                                            <span class="input-group-text">
                                                Q
                                            </span>

                                            <input type="number"
                                                   name="precioUnitario"
                                                   value="@detalle.PrecioUnitario.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                   min="0.01"
                                                   step="0.01"
                                                   class="form-control" />

                                        </div>

                                        <small class="text-muted">
                                            Precio por @detalle.Presentacion.ToLower()
                                        </small>

                                    </div>


                                    <div class="col-md-4 mb-3">

                                        <button type="submit"
                                                class="btn btn-primary w-100">
                                            Guardar cantidad y precio
                                        </button>

                                    </div>

                                </div>

                            </form>
                        }
                        else
                        {
                            <div class="row">

                                <div class="col-md-4">
                                    <small class="text-muted d-block">
                                        Cantidad entregada
                                    </small>

                                    <strong>
                                        @detalle.Cantidad
                                        @detalle.Presentacion@(detalle.Cantidad == 1 ? "" : "s")
                                    </strong>
                                </div>


                                <div class="col-md-4">
                                    <small class="text-muted d-block">
                                        Precio unitario
                                    </small>

                                    <strong>
                                        Q @detalle.PrecioUnitario.ToString("0.00")
                                    </strong>
                                </div>


                                <div class="col-md-4">
                                    <small class="text-muted d-block">
                                        Subtotal
                                    </small>

                                    <strong>
                                        Q @detalle.Subtotal.ToString("0.00")
                                    </strong>
                                </div>

                            </div>
                        }

                    </div>
                }


                <!-- TOTAL -->
                <div class="d-flex justify-content-end mt-4">

                    <div class="text-end">

                        <small class="text-muted d-block">
                            Total de la receta
                        </small>

                        <strong class="fs-4">
                            Q @totalReceta.ToString("0.00")
                        </strong>

                    </div>

                </div>


                <!-- CONFIRMAR ENTREGA -->
                @if (!entregada)
                {
                    <hr class="my-4" />

                    <div class="d-flex justify-content-end">

                        <form asp-action="Entregar"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-success">
                                Confirmar entrega
                            </button>

                        </form>

                    </div>
                }

            }

        </div>

    </div>

</div>