@model IEnumerable<Asilo.Web.Models.SolicitudMedica>

@{
    ViewData["Title"] = "Fundación";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Fundación</h2>
            <p class="text-muted">
                Gestión y programación de solicitudes médicas.
            </p>
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Advertencia"] != null)
    {
        <div class="alert alert-warning">
            @TempData["Advertencia"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay solicitudes médicas registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Fecha solicitud</th>
                        <th>Paciente</th>
                        <th>Motivo</th>
                        <th>Especialidad</th>
                        <th>Especialista</th>
                        <th>Enfermero</th>
                        <th>Fecha atención</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var solicitud in Model)
                    {
                        <tr>

                            <td>
                                @solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @solicitud.Paciente?.NombreCompleto
                            </td>

                            <td>
                                @solicitud.Motivo
                            </td>

                            <td>
                                @(solicitud.Especialidad ?? "Pendiente")
                            </td>

                            <td>
                                @(solicitud.MedicoEspecialista?.NombreUsuario
                                    ?? "Pendiente")
                            </td>

                            <td>
                                @(solicitud.Enfermero?.NombreUsuario
                                    ?? "Pendiente")
                            </td>

                            <td>
                                @(solicitud.FechaAtencion.HasValue
                                    ? solicitud.FechaAtencion.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "Pendiente")
                            </td>

                            <td>
                                @solicitud.Estado
                            </td>

                            <td>
                                @if (solicitud.Estado == "Pendiente de Fundación")
                                {
                                    <a asp-action="Asignar"
                                       asp-route-id="@solicitud.Id"
                                       class="btn btn-primary btn-sm">
                                        Asignar atención
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Programada
                                    </span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>
