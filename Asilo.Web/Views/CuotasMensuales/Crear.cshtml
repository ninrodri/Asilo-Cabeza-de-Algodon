@model Asilo.Web.Models.CuotaMensual

@{
    ViewData["Title"] = "Nueva cuota mensual";
}

<div class="container mt-4">

    <h2>Nueva cuota mensual</h2>

    <p class="text-muted">
        Registre la cuota mensual correspondiente al paciente.
    </p>

    <form asp-action="Crear"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label asp-for="PacienteId"
                   class="form-label">
                Paciente
            </label>

            <select asp-for="PacienteId"
                    class="form-select">

                <option value="">
                    Seleccione un paciente
                </option>

                @foreach (var paciente in ViewBag.Pacientes)
                {
                    <option value="@paciente.Id">
                        @paciente.NombreCompleto
                    </option>
                }

            </select>

            <span asp-validation-for="PacienteId"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Mes"
                   class="form-label">
            </label>

            <select asp-for="Mes"
                    class="form-select">

                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>

            </select>

        </div>

        <div class="mb-3">

            <label asp-for="Anio"
                   class="form-label">
            </label>

            <input asp-for="Anio"
                   type="number"
                   min="2020"
                   max="2100"
                   class="form-control" />

            <span asp-validation-for="Anio"
                  class="text-danger">
            </span>

        </div>

        <div class="mb-3">

            <label asp-for="Monto"
                   class="form-label">
            </label>

            <input asp-for="Monto"
                   type="number"
                   min="0.01"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Monto"
                  class="text-danger">
            </span>

        </div>

        <button type="submit"
                class="btn btn-primary">
            Generar cuota
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>