@model Asilo.Web.Models.FichaMedica

@{
    ViewData["Title"] = "Ficha médica";

    var puedeEditar =
        User.IsInRole("Administrador") ||
        User.IsInRole("Médico general") ||
        User.IsInRole("Médico especialista");

    int? visitaId = ViewBag.VisitaId as int?;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Ficha médica</h2>

            <p class="text-muted mb-0">
                Información clínica del paciente.
            </p>
        </div>

        <div class="d-flex gap-2">

            @if (puedeEditar)
            {
                <a asp-action="Editar"
                   asp-route-id="@Model.Id"
                   class="btn btn-warning">
                    Editar ficha médica
                </a>
            }

            @if (visitaId.HasValue)
            {
                <a asp-controller="VisitaMedica"
                   asp-action="Ver"
                   asp-route-id="@visitaId.Value"
                   class="btn btn-secondary">
                    Volver
                </a>
            }
            else
            {
                <a asp-controller="Ancianos"
                   asp-action="Detalle"
                   asp-route-id="@Model.PacienteId"
                   class="btn btn-secondary">
                    Volver
                </a>
            }

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <h4 class="mb-3">
                @Model.Paciente?.NombreCompleto
            </h4>

            <hr />

            <div class="mb-3">
                <strong>Padecimientos:</strong>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Padecimientos)
                        ? "No registrados"
                        : Model.Padecimientos)
                </p>
            </div>

            <div class="mb-3">
                <strong>Enfermedades:</strong>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Enfermedades)
                        ? "No registradas"
                        : Model.Enfermedades)
                </p>
            </div>

            <div class="mb-3">
                <strong>Psicopatologías:</strong>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Psicopatologias)
                        ? "No registradas"
                        : Model.Psicopatologias)
                </p>
            </div>

            <div class="mb-3">
                <strong>Medicamentos frecuentes:</strong>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.MedicamentosFrecuentes)
                        ? "No registrados"
                        : Model.MedicamentosFrecuentes)
                </p>
            </div>

            <div class="mb-3">
                <strong>Alergias:</strong>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.Alergias)
                        ? "No registradas"
                        : Model.Alergias)
                </p>
            </div>

            <div class="mb-3">
                <strong>Observaciones médicas:</strong>

                <p>
                    @(string.IsNullOrWhiteSpace(Model.ObservacionesMedicas)
                        ? "Sin observaciones"
                        : Model.ObservacionesMedicas)
                </p>
            </div>

            <div class="mb-0">
                <strong>Última actualización:</strong>

                <p class="mb-0">
                    @Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>

        </div>

    </div>

</div>