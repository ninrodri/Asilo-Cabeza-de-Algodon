@model Asilo.Web.Models.Cobro

@{
    ViewData["Title"] = "Detalle del cobro";

    var totalPagado = Model.Pagos.Sum(p => p.Monto);
    var saldoPendiente = Model.Total - totalPagado;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Detalle del cobro</h2>
            <p class="text-muted">
                Resumen de los servicios médicos cargados al paciente.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <p>
                <strong>Paciente:</strong>
                @Model.Paciente?.NombreCompleto
            </p>

            <p>
                <strong>Fecha del cobro:</strong>
                @Model.FechaCobro.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Estado:</strong>
                @Model.Estado
            </p>

        </div>
    </div>

    <h4>Detalle de cargos</h4>

    <div class="table-responsive mb-4">
        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th>Monto</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>@detalle.Tipo</td>
                        <td>@detalle.Descripcion</td>
                        <td>Q @detalle.Monto.ToString("0.00")</td>
                    </tr>
                }

            </tbody>

        </table>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <p>
                <strong>Subtotal:</strong>
                Q @Model.Subtotal.ToString("0.00")
            </p>

            <p>
                <strong>Descuento Fundación:</strong>
                @Model.PorcentajeDescuento.ToString("0.##") %
            </p>

            <p>
                <strong>Monto descontado:</strong>
                Q @Model.MontoDescuento.ToString("0.00")
            </p>

            <hr />

            <h5>
                Total a pagar:
                Q @Model.Total.ToString("0.00")
            </h5>

            <p>
                <strong>Total pagado:</strong>
                Q @totalPagado.ToString("0.00")
            </p>

            <p>
                <strong>Saldo pendiente:</strong>
                Q @saldoPendiente.ToString("0.00")
            </p>

        </div>
    </div>

    @if (saldoPendiente > 0)
    {
        <div class="card shadow-sm mt-4">
            <div class="card-body">

                <h4 class="mb-3">
                    Registrar pago
                </h4>

                @if (TempData["Advertencia"] != null)
                {
                    <div class="alert alert-warning">
                        @TempData["Advertencia"]
                    </div>
                }

                <form asp-action="RegistrarPago"
                      method="post">

                    <input type="hidden"
                           name="cobroId"
                           value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">
                            Monto
                        </label>

                        <input type="number"
                               name="monto"
                               min="0.01"
                               step="0.01"
                               max="@saldoPendiente.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Método de pago
                        </label>

                        <select name="metodoPago"
                                class="form-select"
                                required>

                            <option value="">
                                Seleccione
                            </option>

                            <option value="Efectivo">
                                Efectivo
                            </option>

                            <option value="Transferencia">
                                Transferencia
                            </option>

                            <option value="Depósito">
                                Depósito
                            </option>

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Referencia
                        </label>

                        <input type="text"
                               name="referencia"
                               class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Observaciones
                        </label>

                        <textarea name="observaciones"
                                  class="form-control"
                                  rows="3">
                    </textarea>
                    </div>

                    <button type="submit"
                            class="btn btn-success">
                        Registrar pago
                    </button>

                </form>

            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success mt-4">
            Este cobro está completamente pagado.
        </div>
    }



</div>