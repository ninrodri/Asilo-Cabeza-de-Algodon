@model Asilo.Web.Models.Anciano

@{
    ViewData["Title"] = "Análisis médico por paciente";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h2>Reporte de análisis médico por paciente</h2>

            <p class="text-muted mb-0">
                Consulta de ficha médica, antecedentes, historial y medicamentos
                registrados para el paciente.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-secondary">
                Volver a reportes
            </a>
        </div>

    </div>


    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  asp-action="AnalisisMedico"
                  class="row g-3 align-items-end">

                <div class="col-md-8">

                    <label class="form-label fw-semibold">
                        Paciente
                    </label>

                    <select name="pacienteId"
                            class="form-select">

                        <option value="">
                            Seleccione un paciente
                        </option>

                        @foreach (var paciente in ViewBag.Pacientes)
                        {
                            if (ViewBag.PacienteId != null &&
                                paciente.Id == (int)ViewBag.PacienteId)
                            {
                                <option value="@paciente.Id" selected>
                                    @paciente.NombreCompleto
                                </option>
                            }
                            else
                            {
                                <option value="@paciente.Id">
                                    @paciente.NombreCompleto
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-4">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Consultar
                        </button>

                        <a asp-action="AnalisisMedico"
                           class="btn btn-outline-secondary">
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>


    @if (Model != null)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h4 class="mb-3">
                    Información del paciente
                </h4>

                <p>
                    <strong>Nombre:</strong>
                    @Model.NombreCompleto
                </p>

                <p>
                    <strong>Fecha de nacimiento:</strong>
                    @(Model.FechaNacimiento.HasValue
                        ? Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                        : "No registrada")
                </p>

                <p class="mb-0">
                    <strong>Motivo de ingreso:</strong>
                    @(string.IsNullOrWhiteSpace(Model.MotivoIngreso)
                        ? "No registrado"
                        : Model.MotivoIngreso)
                </p>

            </div>

        </div>


        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h4 class="mb-3">
                    Ficha médica
                </h4>

                @if (Model.FichaMedica != null)
                {
                    <p>
                        <strong>Padecimientos:</strong>
                        @(string.IsNullOrWhiteSpace(Model.FichaMedica.Padecimientos)
                            ? "No registrados"
                            : Model.FichaMedica.Padecimientos)
                    </p>

                    <p>
                        <strong>Enfermedades:</strong>
                        @(string.IsNullOrWhiteSpace(Model.FichaMedica.Enfermedades)
                            ? "No registradas"
                            : Model.FichaMedica.Enfermedades)
                    </p>

                    <p>
                        <strong>Psicopatologías:</strong>
                        @(string.IsNullOrWhiteSpace(Model.FichaMedica.Psicopatologias)
                            ? "No registradas"
                            : Model.FichaMedica.Psicopatologias)
                    </p>

                    <p>
                        <strong>Medicamentos frecuentes:</strong>
                        @(string.IsNullOrWhiteSpace(Model.FichaMedica.MedicamentosFrecuentes)
                            ? "No registrados"
                            : Model.FichaMedica.MedicamentosFrecuentes)
                    </p>

                    <p>
                        <strong>Alergias:</strong>
                        @(string.IsNullOrWhiteSpace(Model.FichaMedica.Alergias)
                            ? "No registradas"
                            : Model.FichaMedica.Alergias)
                    </p>

                    <p class="mb-0">
                        <strong>Observaciones médicas:</strong>
                        @(string.IsNullOrWhiteSpace(Model.FichaMedica.ObservacionesMedicas)
                            ? "Sin observaciones"
                            : Model.FichaMedica.ObservacionesMedicas)
                    </p>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        El paciente no tiene ficha médica registrada.
                    </div>
                }

            </div>

        </div>


        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h4 class="mb-3">
                    Historial médico
                </h4>

                @if (Model.HistorialMedico.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Descripción</th>
                                    <th>Profesional</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var registro in Model.HistorialMedico
                                    .OrderByDescending(h => h.Fecha))
                                {
                                    <tr>

                                        <td>
                                            @registro.Fecha.ToString("dd/MM/yyyy HH:mm")
                                        </td>

                                        <td>
                                            @registro.TipoRegistro
                                        </td>

                                        <td>
                                            @registro.Descripcion
                                        </td>

                                        <td>
                                            @registro.ProfesionalResponsable
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        No hay historial médico registrado.
                    </div>
                }

            </div>

        </div>


        <div class="card shadow-sm">

            <div class="card-body">

                <h4 class="mb-3">
                    Medicamentos recetados
                </h4>

                @{
                    var medicamentos = Model.VisitasMedicas
                        .Where(v => v.Receta != null)
                        .SelectMany(v => v.Receta!.Detalles)
                        .ToList();
                }

                @if (medicamentos.Any())
                {
                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Medicamento</th>
                                    <th>Dosis</th>
                                    <th>Frecuencia</th>
                                    <th>Duración</th>
                                    <th>Indicaciones</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var medicamento in medicamentos)
                                {
                                    <tr>

                                        <td>
                                            @medicamento.Medicamento
                                        </td>

                                        <td>
                                            @medicamento.Dosis
                                        </td>

                                        <td>
                                            @medicamento.Frecuencia
                                        </td>

                                        <td>
                                            @medicamento.Duracion
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(medicamento.Indicaciones)
                                                ? "-"
                                                : medicamento.Indicaciones)
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        No hay medicamentos recetados.
                    </div>
                }

            </div>

        </div>
    }

</div>