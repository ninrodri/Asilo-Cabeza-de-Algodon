@model IEnumerable<Asilo.Web.Models.Cobro>

@{
    ViewData["Title"] = "Cobros por paciente";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h2>Reporte de cobros por paciente</h2>

        <p class="text-muted mb-0">
            Consulta de cobros y gastos médicos por paciente y rango de fechas.
        </p>
    </div>

    <div>
        <a asp-action="Index"
           class="btn btn-secondary">
            Volver a reportes
        </a>
    </div>

</div>

    <div class="card shadow-sm mb-4">
    <div class="card-body">

        <form method="get"
              asp-action="CobrosPorPaciente"
              class="row g-3 align-items-end">

            <div class="col-md-4">

                <label class="form-label fw-semibold">
                    Paciente
                </label>

                <select name="pacienteId"
                        class="form-select">

                    <option value="">
                        Todos los pacientes
                    </option>

                    @foreach (var paciente in ViewBag.Pacientes)
                    {
                        if (ViewBag.PacienteId != null &&
                            paciente.Id == (int)ViewBag.PacienteId)
                        {
                            <option value="@paciente.Id" selected>
                                @paciente.NombreCompleto
                            </option>
                        }
                        else
                        {
                            <option value="@paciente.Id">
                                @paciente.NombreCompleto
                            </option>
                        }
                    }

                </select>

            </div>

            <div class="col-md-3">

                <label class="form-label fw-semibold">
                    Desde
                </label>

                <input type="date"
                       name="fechaInicio"
                       value="@ViewBag.FechaInicio"
                       class="form-control" />

            </div>

            <div class="col-md-3">

                <label class="form-label fw-semibold">
                    Hasta
                </label>

                <input type="date"
                       name="fechaFin"
                       value="@ViewBag.FechaFin"
                       class="form-control" />

            </div>

            <div class="col-md-2">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Filtrar
                    </button>

                    <a asp-action="CobrosPorPaciente"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>

                </div>

            </div>

        </form>

    </div>
</div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay cobros para los criterios seleccionados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Paciente</th>
                        <th>Detalle médico</th>
                        <th>Total</th>
                        <th>Pagado</th>
                        <th>Saldo</th>
                        <th>Estado</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var cobro in Model)
                    {
                        var pagado = cobro.Pagos.Sum(p => p.Monto);
                        var saldo = cobro.Total - pagado;

                        <tr>

                            <td>
                                @cobro.FechaCobro.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @cobro.Paciente?.NombreCompleto
                            </td>

                            <td>
                                @foreach (var detalle in cobro.Detalles)
                                {
                                    <div>
                                        <strong>@detalle.Tipo:</strong>
                                        @detalle.Descripcion
                                        -
                                        Q @detalle.Monto.ToString("0.00")
                                    </div>
                                }
                            </td>

                            <td>
                                Q @cobro.Total.ToString("0.00")
                            </td>

                            <td>
                                Q @pagado.ToString("0.00")
                            </td>

                            <td>
                                Q @saldo.ToString("0.00")
                            </td>

                            <td>
                                @cobro.Estado
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>