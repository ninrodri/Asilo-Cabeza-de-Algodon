@{
    ViewData["Title"] = "Reporte de Entradas";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Reporte de entradas</h2>

        <p class="text-muted">
            Consulta de ingresos recibidos por donaciones y cobros.
        </p>
    </div>

    <form method="get"
          asp-action="Entradas"
          class="row g-3 mb-4">

        <div class="col-md-4">

            <label class="form-label">
                Fecha inicial
            </label>

            <input type="date"
                   name="fechaInicio"
                   value="@ViewBag.FechaInicio"
                   class="form-control" />

        </div>

        <div class="col-md-4">

            <label class="form-label">
                Fecha final
            </label>

            <input type="date"
                   name="fechaFin"
                   value="@ViewBag.FechaFin"
                   class="form-control" />

        </div>

        <div class="col-md-4 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary">
                Filtrar
            </button>

        </div>

    </form>

    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Donaciones</h5>
                    <h4>
                        Q @ViewBag.TotalDonaciones.ToString("0.00")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Pagos recibidos</h5>
                    <h4>
                        Q @ViewBag.TotalPagos.ToString("0.00")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Total entradas</h5>
                    <h4>
                        Q @ViewBag.TotalEntradas.ToString("0.00")
                    </h4>
                </div>
            </div>
        </div>

    </div>

    <h4>Donaciones</h4>

    <div class="table-responsive mb-4">

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Donante</th>
                    <th>Tipo</th>
                    <th>Monto</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var donacion in ViewBag.Donaciones)
                {
                    <tr>
                        <td>
                            @donacion.FechaDonacion.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @donacion.NombreDonante
                        </td>

                        <td>
                            @donacion.TipoDonante
                        </td>

                        <td>
                            Q @donacion.Monto.ToString("0.00")
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <h4>Pagos recibidos</h4>

    <div class="table-responsive">

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Paciente</th>
                    <th>Método</th>
                    <th>Referencia</th>
                    <th>Monto</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var pago in ViewBag.Pagos)
                {
                    <tr>

                        <td>
                            @pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @pago.Cobro?.Paciente?.NombreCompleto
                        </td>

                        <td>
                            @pago.MetodoPago
                        </td>

                        <td>
                            @pago.Referencia
                        </td>

                        <td>
                            Q @pago.Monto.ToString("0.00")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>