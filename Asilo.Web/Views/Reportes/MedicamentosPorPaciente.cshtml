@model IEnumerable<Asilo.Web.Models.MedicamentoAplicado>

@{
    ViewData["Title"] = "Medicamentos aplicados por paciente";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h2>Reporte de medicamentos aplicados por paciente</h2>

            <p class="text-muted mb-0">
                Consulta estadística de medicamentos o tratamientos aplicados
                durante las visitas médicas.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-secondary">
                Volver a reportes
            </a>
        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form method="get"
                  asp-action="MedicamentosPorPaciente"
                  class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Paciente
                    </label>

                    <select name="pacienteId"
                            class="form-select">

                        <option value="">
                            Seleccione un paciente
                        </option>

                        @foreach (var paciente in ViewBag.Pacientes)
                        {
                            if (ViewBag.PacienteId != null &&
                                paciente.Id == (int)ViewBag.PacienteId)
                            {
                                <option value="@paciente.Id" selected>
                                    @paciente.NombreCompleto
                                </option>
                            }
                            else
                            {
                                <option value="@paciente.Id">
                                    @paciente.NombreCompleto
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Desde
                    </label>

                    <input type="date"
                           name="fechaInicio"
                           value="@ViewBag.FechaInicio"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Hasta
                    </label>

                    <input type="date"
                           name="fechaFin"
                           value="@ViewBag.FechaFin"
                           class="form-control" />

                </div>

                <div class="col-md-2">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Filtrar
                        </button>

                        <a asp-action="MedicamentosPorPaciente"
                           class="btn btn-outline-secondary">
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    @if (ViewBag.SeleccionarPaciente == true)
    {
        <div class="alert alert-info">
            Seleccione un paciente para consultar sus medicamentos o tratamientos aplicados.
        </div>
    }
    else
    {
        <div class="row mb-4">

            <div class="col-md-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h6 class="text-muted">
                            Total de aplicaciones
                        </h6>

                        <h3 class="mb-0">
                            @ViewBag.TotalAplicaciones
                        </h3>

                    </div>

                </div>

            </div>

        </div>


        @if (Model.Any())
        {
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <div class="mb-3">

                        <h5 class="mb-1">
                            Aplicaciones por medicamento
                        </h5>

                        <p class="text-muted mb-0">
                            Cantidad de aplicaciones registradas por medicamento o tratamiento.
                        </p>

                    </div>

                    <div style="height: 320px;">
                        <canvas id="graficaMedicamentos"></canvas>
                    </div>

                </div>

            </div>
        }


        @if (!Model.Any())
        {
            <div class="alert alert-info">
                El paciente seleccionado no tiene medicamentos o tratamientos
                aplicados para los criterios seleccionados.
            </div>
        }
        else
        {
            <div class="card shadow-sm mb-4">

                <div class="card-body">

                    <h5 class="mb-3">
                        Detalle de medicamentos aplicados
                    </h5>

                    <div class="table-responsive">

                        <table class="table table-striped table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Paciente</th>
                                    <th>Medicamento / tratamiento</th>
                                    <th>Cantidad</th>
                                    <th>Tiempo de aplicación</th>
                                    <th>Médico</th>
                                    <th>Registrado por</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var aplicacion in Model)
                                {
                                    <tr>

                                        <td>
                                            @aplicacion.FechaAplicacion.ToString("dd/MM/yyyy HH:mm")
                                        </td>

                                        <td>
                                            @aplicacion.VisitaMedica?.Paciente?.NombreCompleto
                                        </td>

                                        <td>
                                            <strong>
                                                @aplicacion.Medicamento
                                            </strong>
                                        </td>

                                        <td>
                                            @aplicacion.CantidadAplicada
                                        </td>

                                        <td>
                                            @aplicacion.TiempoAplicacion
                                        </td>

                                        <td>
                                            @aplicacion.VisitaMedica?.Medico
                                        </td>

                                        <td>
                                            @aplicacion.RegistradoPor?.NombreUsuario
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(aplicacion.Observaciones)
                                                ? "-"
                                                : aplicacion.Observaciones)
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }
    }

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const labelsMedicamentos =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    ViewBag.MedicamentosLabels ?? new List<string>()));

        const cantidadesMedicamentos =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    ViewBag.MedicamentosCantidades ?? new List<int>()));

        const contextoMedicamentos =
            document.getElementById('graficaMedicamentos');

        if (contextoMedicamentos) {

            new Chart(contextoMedicamentos, {

                type: 'bar',

                data: {

                    labels: labelsMedicamentos,

                    datasets: [{
                        label: 'Aplicaciones',
                        data: cantidadesMedicamentos,
                        borderWidth: 1
                    }]

                },

                options: {

                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        }

                    },

                    scales: {

                        y: {

                            beginAtZero: true,

                            ticks: {
                                precision: 0
                            }

                        }

                    }

                }

            });

        }

    </script>

}