@model IEnumerable<Asilo.Web.Models.ExamenLaboratorio>

@{
    ViewData["Title"] = "Exámenes por paciente";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Reporte de exámenes médicos por paciente</h2>

        <p class="text-muted">
            Consulta de exámenes de laboratorio solicitados y realizados
            a los pacientes del asilo.
        </p>
    </div>

    <form method="get"
          asp-action="ExamenesPorPaciente"
          class="row g-3 mb-4">

        <div class="col-md-4">

            <label class="form-label">
                Paciente
            </label>

            <select name="pacienteId"
                    class="form-select">

                <option value="">
                    Todos los pacientes
                </option>

                @foreach (var paciente in ViewBag.Pacientes)
                {
                    if (ViewBag.PacienteId != null &&
                        paciente.Id == (int)ViewBag.PacienteId)
                    {
                        <option value="@paciente.Id" selected>
                            @paciente.NombreCompleto
                        </option>
                    }
                    else
                    {
                        <option value="@paciente.Id">
                            @paciente.NombreCompleto
                        </option>
                    }
                }

            </select>

        </div>

        <div class="col-md-3">

            <label class="form-label">
                Fecha inicial
            </label>

            <input type="date"
                   name="fechaInicio"
                   value="@ViewBag.FechaInicio"
                   class="form-control" />

        </div>

        <div class="col-md-3">

            <label class="form-label">
                Fecha final
            </label>

            <input type="date"
                   name="fechaFin"
                   value="@ViewBag.FechaFin"
                   class="form-control" />

        </div>

        <div class="col-md-2 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary">
                Filtrar
            </button>

        </div>

    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay exámenes registrados para los criterios seleccionados.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Fecha solicitud</th>
                        <th>Paciente</th>
                        <th>Examen</th>
                        <th>Estado</th>
                        <th>Resultado</th>
                        <th>Fecha resultado</th>
                        <th>Costo</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var examen in Model)
                    {
                        <tr>

                            <td>
                                @examen.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @examen.Paciente?.NombreCompleto
                            </td>

                            <td>
                                @examen.NombreExamen
                            </td>

                            <td>
                                @examen.Estado
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(examen.Resultado)
                                    ? "Sin resultado"
                                    : examen.Resultado)
                            </td>

                            <td>
                                @(examen.FechaResultado.HasValue
                                    ? examen.FechaResultado.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "Pendiente")
                            </td>

                            <td>
                                Q @examen.Costo.ToString("0.00")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>