@using System.Globalization
@model IEnumerable<Asilo.Web.Models.ExamenLaboratorio>

@{
    ViewData["Title"] = "Exámenes por paciente";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h2>Reporte de exámenes médicos por paciente</h2>

            <p class="text-muted mb-0">
                Consulta estadística de exámenes de laboratorio solicitados y realizados
                a los pacientes del asilo.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-secondary">
                Volver a reportes
            </a>
        </div>

    </div>


    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  asp-action="ExamenesPorPaciente"
                  class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Paciente
                    </label>

                    <select name="pacienteId"
                            class="form-select">

                        <option value="">
                            Todos los pacientes
                        </option>

                        @foreach (var paciente in ViewBag.Pacientes)
                        {
                            if (ViewBag.PacienteId != null &&
                                paciente.Id == (int)ViewBag.PacienteId)
                            {
                                <option value="@paciente.Id" selected>
                                    @paciente.NombreCompleto
                                </option>
                            }
                            else
                            {
                                <option value="@paciente.Id">
                                    @paciente.NombreCompleto
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Desde
                    </label>

                    <input type="date"
                           name="fechaInicio"
                           value="@ViewBag.FechaInicio"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label class="form-label fw-semibold">
                        Hasta
                    </label>

                    <input type="date"
                           name="fechaFin"
                           value="@ViewBag.FechaFin"
                           class="form-control" />

                </div>

                <div class="col-md-2">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Filtrar
                        </button>

                        <a asp-action="ExamenesPorPaciente"
                           class="btn btn-outline-secondary">
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>


    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Total de exámenes
                    </h6>

                    <h3 class="mb-0">
                        @ViewBag.TotalExamenes
                    </h3>

                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Completados
                    </h6>

                    <h3 class="mb-0">
                        @ViewBag.TotalCompletados
                    </h3>

                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Pendientes
                    </h6>

                    <h3 class="mb-0">
                        @ViewBag.TotalPendientes
                    </h3>

                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Costo total
                    </h6>

                    <h4 class="mb-0">
                        Q @ViewBag.CostoTotalExamenes.ToString("0.00")
                    </h4>

                </div>
            </div>
        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h5 class="mb-1">
                        Estado de los exámenes
                    </h5>

                    <p class="text-muted mb-0">
                        Comparación entre exámenes completados y pendientes.
                    </p>
                </div>

                <div class="text-end">
                    <small class="text-muted">
                        Total
                    </small>

                    <h4 class="mb-0">
                        @ViewBag.TotalExamenes
                    </h4>
                </div>

            </div>

            <div style="height: 320px;">
                <canvas id="graficaExamenes"></canvas>
            </div>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay exámenes registrados para los criterios seleccionados.
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h5 class="mb-3">
                    Detalle de exámenes
                </h5>

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Fecha solicitud</th>
                                <th>Paciente</th>
                                <th>Examen</th>
                                <th>Estado</th>
                                <th>Resultado</th>
                                <th>Fecha resultado</th>
                                <th>Costo</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var examen in Model)
                            {
                                <tr>

                                    <td>
                                        @examen.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @examen.Paciente?.NombreCompleto
                                    </td>

                                    <td>
                                        @examen.NombreExamen
                                    </td>

                                    <td>
                                        @examen.Estado
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(examen.Resultado)
                                            ? "Sin resultado"
                                            : examen.Resultado)
                                    </td>

                                    <td>
                                        @(examen.FechaResultado.HasValue
                                            ? examen.FechaResultado.Value.ToString("dd/MM/yyyy HH:mm")
                                            : "Pendiente")
                                    </td>

                                    <td>
                                        Q @examen.Costo.ToString("0.00")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const contextoExamenes =
            document.getElementById('graficaExamenes');

        if (contextoExamenes) {

            new Chart(contextoExamenes, {

                type: 'bar',

                data: {

                    labels: [
                        'Completados',
                        'Pendientes'
                    ],

                    datasets: [{
                        label: 'Cantidad de exámenes',

                        data: [
                            @ViewBag.TotalCompletados,
                            @ViewBag.TotalPendientes
                        ],

                        borderWidth: 1
                    }]
                },

                options: {

                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        }

                    },

                    scales: {

                        y: {

                            beginAtZero: true,

                            ticks: {
                                precision: 0
                            }

                        }

                    }

                }

            });

        }

    </script>

}