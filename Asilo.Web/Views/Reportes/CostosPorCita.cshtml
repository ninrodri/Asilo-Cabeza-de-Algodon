@using System.Globalization
@model IEnumerable<Asilo.Web.Models.Cobro>

@{
    ViewData["Title"] = "Costos por cita";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <h2>Reporte de costos por cita</h2>

            <p class="text-muted mb-0">
                Consulta estadística de costos médicos por paciente, incluyendo
                consulta, laboratorio, medicamentos, descuento y total final.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-secondary">
                Volver a reportes
            </a>
        </div>

    </div>


    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  asp-action="CostosPorCita"
                  class="row g-3 align-items-end">

                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Paciente
                    </label>

                    <select name="pacienteId"
                            class="form-select">

                        <option value="">
                            Todos los pacientes
                        </option>

                        @foreach (var paciente in ViewBag.Pacientes)
                        {
                            if (ViewBag.PacienteId != null &&
                                paciente.Id == (int)ViewBag.PacienteId)
                            {
                                <option value="@paciente.Id" selected>
                                    @paciente.NombreCompleto
                                </option>
                            }
                            else
                            {
                                <option value="@paciente.Id">
                                    @paciente.NombreCompleto
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-6">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Filtrar
                        </button>

                        <a asp-action="CostosPorCita"
                           class="btn btn-outline-secondary">
                            Limpiar
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>


    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Citas
                    </h6>

                    <h3 class="mb-0">
                        @ViewBag.TotalCitas
                    </h3>

                </div>
            </div>
        </div>


        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Consultas
                    </h6>

                    <h4 class="mb-0">
                        Q @ViewBag.TotalConsultas.ToString("0.00")
                    </h4>

                </div>
            </div>
        </div>


        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Laboratorio
                    </h6>

                    <h4 class="mb-0">
                        Q @ViewBag.TotalLaboratorio.ToString("0.00")
                    </h4>

                </div>
            </div>
        </div>


        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">
                        Medicamentos
                    </h6>

                    <h4 class="mb-0">
                        Q @ViewBag.TotalMedicamentos.ToString("0.00")
                    </h4>

                </div>
            </div>
        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>
                    <h5 class="mb-1">
                        Distribución de costos
                    </h5>

                    <p class="text-muted mb-0">
                        Comparación entre consultas, laboratorio y medicamentos.
                    </p>
                </div>

                <div class="text-end">

                    <small class="text-muted">
                        Total general
                    </small>

                    <h4 class="mb-0">
                        Q @ViewBag.TotalGeneral.ToString("0.00")
                    </h4>

                </div>

            </div>


            <div style="height: 320px;">
                <canvas id="graficaCostos"></canvas>
            </div>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay costos médicos registrados para los criterios seleccionados.
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h5 class="mb-3">
                    Detalle de costos por cita
                </h5>

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Paciente</th>
                                <th>Consulta</th>
                                <th>Laboratorio</th>
                                <th>Medicamentos</th>
                                <th>Subtotal</th>
                                <th>Descuento</th>
                                <th>Total</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var cobro in Model)
                            {
                                var consulta = cobro.Detalles
                                    .Where(d => d.Tipo == "Consulta médica")
                                    .Sum(d => d.Monto);

                                var laboratorio = cobro.Detalles
                                    .Where(d => d.Tipo == "Laboratorio")
                                    .Sum(d => d.Monto);

                                var medicamentos = cobro.Detalles
                                    .Where(d => d.Tipo == "Medicamento")
                                    .Sum(d => d.Monto);

                                <tr>

                                    <td>
                                        @cobro.FechaCobro.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @cobro.Paciente?.NombreCompleto
                                    </td>

                                    <td>
                                        Q @consulta.ToString("0.00")
                                    </td>

                                    <td>
                                        Q @laboratorio.ToString("0.00")
                                    </td>

                                    <td>
                                        Q @medicamentos.ToString("0.00")
                                    </td>

                                    <td>
                                        Q @cobro.Subtotal.ToString("0.00")
                                    </td>

                                    <td>
                                        Q @cobro.MontoDescuento.ToString("0.00")
                                    </td>

                                    <td>
                                        <strong>
                                            Q @cobro.Total.ToString("0.00")
                                        </strong>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const contexto = document.getElementById('graficaCostos');

        if (contexto) {

            new Chart(contexto, {

                type: 'bar',

                data: {

                    labels: [
                        'Consultas',
                        'Laboratorio',
                        'Medicamentos'
                    ],

                    datasets: [{
                        label: 'Costo en quetzales',

                                data: [
            @Convert.ToDecimal(ViewBag.TotalConsultas).ToString(CultureInfo.InvariantCulture),
            @Convert.ToDecimal(ViewBag.TotalLaboratorio).ToString(CultureInfo.InvariantCulture),
            @Convert.ToDecimal(ViewBag.TotalMedicamentos).ToString(CultureInfo.InvariantCulture)
        ],

                        borderWidth: 1
                    }]
                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        },

                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return 'Q ' +
                                        Number(context.raw).toFixed(2);
                                }
                            }
                        }

                    },

                    scales: {

                        y: {

                            beginAtZero: true,

                            ticks: {
                                callback: function (value) {
                                    return 'Q ' + value;
                                }
                            }

                        }

                    }

                }

            });

        }

    </script>

}