@model IEnumerable<Asilo.Web.Models.PagoFundacion>

@{
    ViewData["Title"] = "Pagos a la Fundación";
    var totalPagos = Model.Sum(p => p.Monto);
}

<div class="container mt-4">

  <div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h2>Reporte de pagos a la Fundación</h2>

        <p class="text-muted mb-0">
            Consulta de pagos realizados a la Fundación por rango de fechas.
        </p>
    </div>

    <div>
        <a asp-action="Index"
           class="btn btn-secondary">
            Volver a reportes
        </a>
    </div>

</div>

    <div class="card shadow-sm mb-4">
    <div class="card-body">

        <form method="get"
              asp-action="PagosFundacion"
              class="row g-3 align-items-end">

            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    Desde
                </label>

                <input type="date"
                       name="fechaInicio"
                       value="@ViewBag.FechaInicio"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">
                    Hasta
                </label>

                <input type="date"
                       name="fechaFin"
                       value="@ViewBag.FechaFin"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Filtrar
                    </button>

                    <a asp-action="PagosFundacion"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>

                </div>
            </div>

        </form>

    </div>
</div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay pagos a la Fundación registrados para el rango seleccionado.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Monto</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th>Observaciones</th>
                        <th>Registrado por</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var pago in Model)
                    {
                        <tr>

                            <td>
                                @pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                Q @pago.Monto.ToString("0.00")
                            </td>

                            <td>
                                @pago.MetodoPago
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(pago.Referencia)
                                    ? "-"
                                    : pago.Referencia)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(pago.Observaciones)
                                    ? "-"
                                    : pago.Observaciones)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(pago.RegistradoPor)
                                    ? "Registro anterior"
                                    : pago.RegistradoPor)
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="text-end mt-3">

            <h5>
                Total pagado a la Fundación:
                Q @totalPagos.ToString("0.00")
            </h5>

        </div>
    }

</div>