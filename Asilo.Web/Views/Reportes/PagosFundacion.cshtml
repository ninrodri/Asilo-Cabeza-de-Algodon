@model IEnumerable<Asilo.Web.Models.Pago>

@{
    ViewData["Title"] = "Pagos a la Fundación";
    var totalPagos = Model.Sum(p => p.Monto);
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Reporte de pagos a la Fundación</h2>

        <p class="text-muted">
            Consulta de pagos recibidos por concepto de servicios médicos
            y cuotas mensuales.
        </p>
    </div>

    <form method="get"
          asp-action="PagosFundacion"
          class="row g-3 mb-4">

        <div class="col-md-4">

            <label class="form-label">
                Fecha inicial
            </label>

            <input type="date"
                   name="fechaInicio"
                   value="@ViewBag.FechaInicio"
                   class="form-control" />

        </div>

        <div class="col-md-4">

            <label class="form-label">
                Fecha final
            </label>

            <input type="date"
                   name="fechaFin"
                   value="@ViewBag.FechaFin"
                   class="form-control" />

        </div>

        <div class="col-md-4 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary">
                Filtrar
            </button>

        </div>

    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay pagos registrados para el rango seleccionado.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Paciente</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th>Observaciones</th>
                        <th>Monto</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var pago in Model)
                    {
                        <tr>

                            <td>
                                @pago.FechaPago.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @pago.Cobro?.Paciente?.NombreCompleto
                            </td>

                            <td>
                                @pago.MetodoPago
                            </td>

                            <td>
                                @pago.Referencia
                            </td>

                            <td>
                                @pago.Observaciones
                            </td>

                            <td>
                                Q @pago.Monto.ToString("0.00")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="text-end mt-3">

            <h5>
                Total recibido:
                Q @totalPagos.ToString("0.00")
            </h5>

        </div>
    }

</div>