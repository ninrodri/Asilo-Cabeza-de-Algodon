@model Asilo.Web.ViewModels.CuentaFundacionViewModel

@{
    ViewData["Title"] = "Cuenta Fundación";
}

<div class="container mt-4 mb-5">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Cuenta Fundación
            </h2>

            <p class="text-muted mb-0">
                Control de los servicios médicos cubiertos por Fundación
                y de los pagos realizados.
            </p>
        </div>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary">
            Volver al menú principal
        </a>

    </div>


    <!-- MENSAJES -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }


    <!-- RESUMEN POR TIPO DE SERVICIO -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h4 class="mb-4">
                Resumen de deuda
            </h4>


            <div class="row text-center">

                <!-- CONSULTAS -->
                <div class="col-md-4 mb-3">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            Consultas médicas
                        </small>

                        <strong class="fs-5">
                            Q @Model.TotalConsultas.ToString("N2")
                        </strong>

                    </div>

                </div>


                <!-- LABORATORIO -->
                <div class="col-md-4 mb-3">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            Exámenes de laboratorio
                        </small>

                        <strong class="fs-5">
                            Q @Model.TotalLaboratorio.ToString("N2")
                        </strong>

                    </div>

                </div>


                <!-- MEDICAMENTOS -->
                <div class="col-md-4 mb-3">

                    <div class="border rounded p-3 h-100">

                        <small class="text-muted d-block mb-1">
                            Medicamentos
                        </small>

                        <strong class="fs-5">
                            Q @Model.TotalMedicamentos.ToString("N2")
                        </strong>

                    </div>

                </div>

            </div>


            <hr />


            <!-- TOTALES -->
            <div class="row mt-4">

                <!-- TOTAL ADEUDADO -->
                <div class="col-md-4 mb-3">

                    <small class="text-muted d-block">
                        Total adeudado
                    </small>

                    <strong class="fs-4">
                        Q @Model.TotalAdeudado.ToString("N2")
                    </strong>

                </div>


                <!-- TOTAL PAGADO -->
                <div class="col-md-4 mb-3">

                    <small class="text-muted d-block">
                        Total pagado
                    </small>

                    <strong class="fs-4 text-success">
                        Q @Model.TotalPagado.ToString("N2")
                    </strong>

                </div>


                <!-- SALDO PENDIENTE -->
                <div class="col-md-4 mb-3">

                    <small class="text-muted d-block">
                        Saldo pendiente
                    </small>

                    <strong class="fs-4 text-danger">
                        Q @Model.SaldoPendiente.ToString("N2")
                    </strong>

                </div>

            </div>


            <!-- BOTÓN DE PAGO -->
            @if (Model.SaldoPendiente > 0)
            {
                <div class="mt-3">

                    <a asp-action="RegistrarPago"
                       class="btn btn-primary">
                        Registrar pago a Fundación
                    </a>

                </div>
            }
            else
            {
                <div class="alert alert-success mt-3 mb-0">
                    No existe saldo pendiente con Fundación.
                </div>
            }

        </div>

    </div>


    <!-- HISTORIAL DE PAGOS -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="mb-3">

                <h4 class="mb-1">
                    Historial de pagos
                </h4>

                <p class="text-muted mb-0">
                    Pagos registrados a favor de Fundación.
                </p>

            </div>


            @if (!Model.Pagos.Any())
            {
                <div class="alert alert-info mb-0">
                    Todavía no existen pagos registrados a Fundación.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead>

                            <tr>
                                <th>Fecha</th>
                                <th>Monto</th>
                                <th>Método</th>
                                <th>Referencia</th>
                                <th>Observaciones</th>
                                <th>Registrado por</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var pago in Model.Pagos)
                            {
                                <tr>

                                    <td>
                                        @pago.FechaPago.ToString(
                                            "dd/MM/yyyy HH:mm"
                                        )
                                    </td>


                                    <td>
                                        <strong class="text-success">
                                            Q @pago.Monto.ToString("N2")
                                        </strong>
                                    </td>


                                    <td>
                                        @pago.MetodoPago
                                    </td>


                                    <td>
                                        @pago.Referencia
                                    </td>


                                    <td>
                                        @pago.Observaciones
                                    </td>


                                    <td>
                                        @if (string.IsNullOrWhiteSpace(
                                            pago.RegistradoPor))
                                        {
                                            <span class="text-muted">
                                                Registro anterior
                                            </span>
                                        }
                                        else
                                        {
                                            @pago.RegistradoPor
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>