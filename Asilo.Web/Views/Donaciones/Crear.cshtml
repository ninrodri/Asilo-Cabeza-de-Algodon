@model Asilo.Web.Models.Donacion

@{
    ViewData["Title"] = "Nueva donación";
}

<div class="container mt-4">

    <h2>Nueva donación</h2>

    <p class="text-muted">
        Registre una entrada económica recibida por la fundación.
    </p>

    <form asp-action="Crear"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="TipoDonante"
                   class="form-label">
            </label>

            <select asp-for="TipoDonante"
                    class="form-select">

                <option value="">
                    Seleccione un tipo de donante
                </option>

                <option value="Empresa internacional">
                    Empresa internacional
                </option>

                <option value="Empresa nacional">
                    Empresa nacional
                </option>

                <option value="Gobierno">
                    Gobierno
                </option>

                <option value="Persona particular">
                    Persona particular
                </option>

            </select>

            <span asp-validation-for="TipoDonante"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="NombreDonante"
                   class="form-label">
            </label>

            <input asp-for="NombreDonante"
                   class="form-control" />

            <span asp-validation-for="NombreDonante"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Monto"
                   class="form-label">
            </label>

            <input asp-for="Monto"
                   type="number"
                   min="0.01"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Monto"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion"
                   class="form-label">
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="3">
            </textarea>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Registrar donación
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

</div>