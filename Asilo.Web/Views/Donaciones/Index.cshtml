@model IEnumerable<Asilo.Web.Models.Donacion>

@{
    ViewData["Title"] = "Donaciones";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Donaciones</h2>
            <p class="text-muted">
                Registro y control de donaciones recibidas por la fundación.
            </p>
        </div>

        <a asp-action="Crear"
           class="btn btn-primary">
            Nueva donación
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay donaciones registradas.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo de donante</th>
                        <th>Donante</th>
                        <th>Monto</th>
                        <th>Descripción</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var donacion in Model)
                    {
                        <tr>
                            <td>
                                @donacion.FechaDonacion.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @donacion.TipoDonante
                            </td>

                            <td>
                                @donacion.NombreDonante
                            </td>

                            <td>
                                Q @donacion.Monto.ToString("0.00")
                            </td>

                            <td>
                                @donacion.Descripcion
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>