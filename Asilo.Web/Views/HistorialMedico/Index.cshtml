@model IEnumerable<Asilo.Web.Models.HistorialMedico>

@{
    ViewData["Title"] = "Historial médico";

    var paciente = ViewBag.Paciente as Asilo.Web.Models.Anciano;

    int? visitaId = ViewBag.VisitaId as int?;

    var puedeCrear =
        User.IsInRole("Administrador") ||
        User.IsInRole("Médico general") ||
        User.IsInRole("Médico especialista");
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>

            <h2>Historial médico</h2>

            <p class="text-muted mb-0">
                Paciente:
                <strong>
                    @paciente?.NombreCompleto
                </strong>
            </p>

        </div>


        <div class="d-flex gap-2">

            @if (puedeCrear)
            {
                <a asp-action="Crear"
                   asp-route-pacienteId="@ViewBag.PacienteId"
                   class="btn btn-primary">
                    Nuevo registro
                </a>
            }


            @if (visitaId.HasValue)
            {
                <a asp-controller="VisitaMedica"
                   asp-action="Ver"
                   asp-route-id="@visitaId.Value"
                   class="btn btn-secondary">
                    Volver
                </a>
            }
            else
            {
                <a asp-controller="Ancianos"
                   asp-action="Detalle"
                   asp-route-id="@ViewBag.PacienteId"
                   class="btn btn-secondary">
                    Volver
                </a>
            }

        </div>

    </div>


    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            El paciente no tiene registros en su historial médico.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle mb-0">

                        <thead>

                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Descripción</th>
                                <th>Observaciones</th>
                                <th>Profesional responsable</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var registro in Model)
                            {
                                <tr>

                                    <td>
                                        @registro.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @registro.TipoRegistro
                                    </td>

                                    <td>
                                        @registro.Descripcion
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(registro.Observaciones)
                                            ? "-"
                                            : registro.Observaciones)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(registro.ProfesionalResponsable)
                                            ? "-"
                                            : registro.ProfesionalResponsable)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>